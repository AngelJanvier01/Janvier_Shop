# PostgreSQL local o de staging. Nunca subas tu archivo .env real.
# Docker utiliza estos valores para su base local; cámbialos antes de staging.
POSTGRES_USER="janvier"
POSTGRES_PASSWORD="janvier_dev_only_change_me"
POSTGRES_DB="janvier_v2"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://janvier:janvier_dev_only_change_me@127.0.0.1:5432/janvier_v2?schema=public"

# Secreto de sesión para la futura administración. Generar uno diferente por
# entorno con un gestor de secretos; nunca reutilizar ni subir valores reales.
AUTH_SECRET="replace-with-a-strong-random-secret"

# Administración local inicial. El script de ejecución genera la contraseña si
# sigue usando el marcador. En staging/producción usa valores únicos y seguros.
INITIAL_ADMIN_EMAIL="admin@janvier.local"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-random-password"

# URL pública local de la V2. El legado conserva el puerto 3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
APP_URL="https://example.com"
APP_PORT="3001"
JANVIER_TIMEZONE="America/Mexico_City"
# Actívalo exclusivamente si el proxy/CDN de producción elimina y reconstruye
# CF-Connecting-IP/X-Forwarded-For. El límite durable nunca persiste IPs ni correos.
TRUST_PROXY_CLIENT_IP="false"

# Cobro en línea. MP_PUBLIC_KEY puede llegar al Checkout Brick solamente desde
# una página autenticada; MP_ACCESS_TOKEN y MP_WEBHOOK_SECRET son exclusivos del
# servidor. Inicia con credenciales de prueba y deja los interruptores apagados
# en /admin/ajustes/pagos hasta concluir QA.
MP_PUBLIC_KEY=""
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Activos privados de propuestas. Esta ruta vive en un volumen Docker y nunca
# dentro de public/ ni del repositorio. En producción debe existir y ser persistente.
PROPOSAL_ASSET_STORAGE_DRIVER="local"
PROPOSAL_ASSET_STORAGE_PATH="/var/lib/janvier/proposal-assets"
PROPOSAL_ASSET_MAX_FILE_BYTES="15728640"
PROPOSAL_ASSET_MAX_REVISION_BYTES="157286400"
PROPOSAL_ASSET_GC_GRACE_DAYS="30"

# Recorte local de fondos para imagenes de producto. El modelo se descarga una
# sola vez al volumen Docker; las imagenes y resultados no salen de JANVIER.
PRODUCT_IMAGE_STORAGE_PATH="/var/lib/janvier/product-images"
PRODUCT_IMAGE_MAX_SOURCE_BYTES="20971520"
PRODUCT_IMAGE_SOURCE_HOSTS="janvier01.sicodd.com.mx"
PRODUCT_IMAGE_WORKER_ENABLED="false"
BACKGROUND_REMOVAL_URL="http://background-removal:8080"
BACKGROUND_MODEL_ID="ZhengPeng7/BiRefNet_lite"
BACKGROUND_MODEL_INPUT_SIZE="1536"
BACKGROUND_MODEL_REVISION="7838f1c3472f827cd8ce13ab5ccc2ce48077360f"
BACKGROUND_MODEL_THREADS="2"
BACKGROUND_MASK_GUARD_ENABLED="true"
BACKGROUND_MASK_GUARD_SIZE="512"
BACKGROUND_MASK_GUARD_SEED_ALPHA="144"
BACKGROUND_MASK_GUARD_MIN_LIGHT_BORDER="0.20"
BACKGROUND_MASK_GUARD_COLOR_TOLERANCE="32"
BACKGROUND_MASK_GUARD_MIN_DOMINANT_BORDER="0.85"
BACKGROUND_MASK_COMPLEX_MIN_VISIBLE_RATIO="0.18"

# Acceso de solo lectura para SICODD. Conserva la contraseña real únicamente
# en .env o en el gestor de secretos de producción, nunca en Git.
SICODD_BASE_URL="https://janvier01.sicodd.com.mx"
SICODD_USERNAME=""
SICODD_ADMIN_PASSWORD="replace-with-the-dedicated-sicodd-read-only-password"
# Lista separada por comas de bodegas cuya existencia puede mostrarse al cliente.
# Compatibilidad heredada. Las solicitudes, cotizaciones y pedidos nuevos usan
# exclusivamente EmailOutbox y el proveedor SMTP/Gmail configurado en Admin;
# no dependen de este webhook. Nunca expongas estos valores al navegador.
CUSTOMER_EMAIL_DELIVERY_WEBHOOK_URL=""
CUSTOMER_EMAIL_DELIVERY_WEBHOOK_SECRET=""

# Correo transaccional. Déjalo desactivado hasta configurar SMTP en el servidor.
# Usa una contraseña de aplicación de Gmail; nunca tu contraseña normal.
MAIL_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="alerts@example.com"
SMTP_APP_PASSWORD="replace-with-a-gmail-app-password"
MAIL_FROM="JANVIER <alerts@example.com>"
MAIL_REPLY_TO="alerts@example.com"
ALERT_RECIPIENTS="owner@example.com"

# Google OAuth delivery bootstrap. Keep all values empty until Google Cloud is configured.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="https://example.com/api/admin/settings/email/google/callback"
SETTINGS_ENCRYPTION_KEY=""
GOOGLE_ALLOWED_EMAIL=""
GOOGLE_ALLOWED_DOMAIN=""
GOOGLE_OAUTH_PUBLISHING_STATUS="testing"
