# Copy to .env.production on the server. Never commit the real file.
POSTGRES_USER="janvier"
POSTGRES_PASSWORD="replace-with-a-long-unique-database-password"
POSTGRES_DB="janvier_v2"
APP_PORT="3001"

AUTH_SECRET="replace-with-at-least-32-random-bytes"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-long-unique-admin-password"
NEXT_PUBLIC_SITE_URL="https://example.com"
APP_URL="https://example.com"
JANVIER_TIMEZONE="America/Mexico_City"
TRUST_PROXY_CLIENT_IP="false"

# Mercado Pago Orders API. Usa primero credenciales de prueba. El webhook
# publico debe apuntar a https://TU-DOMINIO/api/webhooks/mercado-pago.
MP_PUBLIC_KEY=""
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Pipeline local de imagenes. PRODUCT_IMAGE_SOURCE_HOSTS es una allowlist CSV.
PRODUCT_IMAGE_STORAGE_PATH="/var/lib/janvier/product-images"
PRODUCT_IMAGE_MAX_SOURCE_BYTES="20971520"
PRODUCT_IMAGE_SOURCE_HOSTS="janvier01.sicodd.com.mx"
PRODUCT_IMAGE_WORKER_ENABLED="false"
BACKGROUND_REMOVAL_URL="http://background-removal:8080"
BACKGROUND_MODEL_ID="ZhengPeng7/BiRefNet_lite"
BACKGROUND_MODEL_INPUT_SIZE="1024"
BACKGROUND_MODEL_REVISION="7838f1c3472f827cd8ce13ab5ccc2ce48077360f"
BACKGROUND_MODEL_THREADS="2"
BACKGROUND_MASK_GUARD_ENABLED="true"
BACKGROUND_MASK_GUARD_SIZE="512"
BACKGROUND_MASK_GUARD_SEED_ALPHA="144"
BACKGROUND_MASK_GUARD_MIN_LIGHT_BORDER="0.20"
BACKGROUND_MASK_GUARD_COLOR_TOLERANCE="32"
BACKGROUND_MASK_GUARD_MIN_DOMINANT_BORDER="0.85"
BACKGROUND_MASK_COMPLEX_MIN_VISIBLE_RATIO="0.18"

# Acceso de solo lectura al proveedor y bodegas autorizadas para el catálogo público.
SICODD_BASE_URL="https://janvier01.sicodd.com.mx"
SICODD_USERNAME=""
SICODD_ADMIN_PASSWORD="replace-with-the-dedicated-sicodd-read-only-password"
SICODD_PUBLIC_WAREHOUSES=""
# Webhook transaccional para verificación y cambios de estado de cuentas cliente.
CUSTOMER_EMAIL_DELIVERY_WEBHOOK_URL=""
CUSTOMER_EMAIL_DELIVERY_WEBHOOK_SECRET=""

# Gmail SMTP for transactional alerts. Keep MAIL_ENABLED=false until ready.
MAIL_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="alerts@example.com"
SMTP_APP_PASSWORD="replace-with-a-gmail-app-password"
MAIL_FROM="JANVIER <alerts@example.com>"
MAIL_REPLY_TO="alerts@example.com"
ALERT_RECIPIENTS="owner@example.com"

# Google OAuth delivery bootstrap. Keep MAIL_ENABLED=false until an authorized deployment.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="https://example.com/api/admin/settings/email/google/callback"
SETTINGS_ENCRYPTION_KEY=""
GOOGLE_ALLOWED_EMAIL=""
GOOGLE_ALLOWED_DOMAIN=""
GOOGLE_OAUTH_PUBLISHING_STATUS="testing"
