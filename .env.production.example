# Copy to .env.production on the server. Never commit the real file.
POSTGRES_USER="janvier"
POSTGRES_PASSWORD="replace-with-a-long-unique-database-password"
POSTGRES_DB="janvier_v2"
APP_PORT="3001"

AUTH_SECRET="replace-with-at-least-32-random-bytes"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-long-unique-admin-password"
NEXT_PUBLIC_SITE_URL="https://example.com"
APP_URL="https://example.com"
JANVIER_TIMEZONE="America/Mexico_City"

# Gmail SMTP for transactional alerts. Keep MAIL_ENABLED=false until ready.
MAIL_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="alerts@example.com"
SMTP_APP_PASSWORD="replace-with-a-gmail-app-password"
MAIL_FROM="JANVIER <alerts@example.com>"
MAIL_REPLY_TO="alerts@example.com"
ALERT_RECIPIENTS="owner@example.com"

# Google OAuth delivery bootstrap. Keep MAIL_ENABLED=false until an authorized deployment.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="https://example.com/api/admin/settings/email/google/callback"
SETTINGS_ENCRYPTION_KEY=""
GOOGLE_ALLOWED_EMAIL=""
GOOGLE_ALLOWED_DOMAIN=""
GOOGLE_OAUTH_PUBLISHING_STATUS="testing"
