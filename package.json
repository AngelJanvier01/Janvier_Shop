{
  "name": "janvier-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de JANVIER: software, ingeniería y suministro tecnológico.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build --webpack",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check app components styles prisma tests docs --ignore-unknown",
    "format:write": "prettier --write app components styles prisma tests docs --ignore-unknown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && set \"PLAYWRIGHT_MODE=production\" && set \"PLAYWRIGHT_BASE_URL=http://localhost:3002\" && set \"NEXT_PUBLIC_SITE_URL=http://localhost:3002\" && npm run test:e2e",
    "test:e2e:install": "playwright install chromium",
    "capture:themes": "tsx tests/visual/capture-theme-comparisons.ts",
    "capture:page-heroes": "tsx tests/visual/capture-page-hero-comparisons.ts",
    "record:theme-stress": "tsx tests/visual/record-theme-stress.ts",
    "record:index-hero-monogram-stress": "tsx tests/visual/record-index-hero-monogram-stress.ts",
    "soak:vector-mode": "tsx tests/visual/vector-mode-soak.ts",
    "audit:production": "tsx tests/visual/audit-production.ts",
    "audit:index-hero-monogram": "tsx tests/visual/audit-index-hero-monogram.ts",
    "capture:index-hero-monogram": "tsx tests/visual/capture-index-hero-monogram.ts",
    "capture:proposal-markdown-renderer": "tsx tests/visual/capture-proposal-markdown-renderer.ts",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "proposals:backfill-markdown": "npm run prisma:generate && tsx scripts/proposals/backfill-markdown-ast.ts",
    "proposals:backup-assets": "tsx scripts/proposals/backup-private-assets.ts",
    "proposals:gc-assets": "tsx scripts/proposals/gc-private-assets.ts",
    "proposals:prune-markdown-checkpoints": "tsx scripts/proposals/prune-markdown-checkpoints.ts",
    "proposals:restore-assets": "tsx scripts/proposals/restore-private-assets.ts",
    "analytics:prune": "tsx scripts/analytics/prune-events.ts",
    "db:bootstrap": "npm run prisma:deploy && npm run proposals:backfill-markdown && npm run prisma:seed"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "next": "16.3.0-canary.106",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "rehype-sanitize": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0-canary.106",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
