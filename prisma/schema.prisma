  PAGE_VIEW
  CTA_CLICK
  OUTBOUND_CLICK
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdProjects                 Project[]                           @relation("ProjectOwner")
  createdProposals                Proposal[]                          @relation("ProposalOwner")
  revisions                       ProposalRevision[]                  @relation("RevisionAuthor")
  comments                        ProposalComment[]                   @relation("AdminCommentAuthor")
  events                          ProposalEvent[]                     @relation("EventAdminActor")
  invites                         ProposalInvite[]                    @relation("InviteCreator")
  sessions                        AdminSession[]
  products                        Product[]                           @relation("ProductCreator")
  reviewedProductImages           ProductImageDerivative[]            @relation("ProductImageReviewer")
  createdProductImageExclusions   ProductImageExclusion[]             @relation("ProductImageExclusionCreator")
  importedMarkdownSources         ProposalMarkdownSource[]            @relation("MarkdownSourceImporter")
  markdownCheckpoints             ProposalMarkdownCheckpoint[]        @relation("MarkdownCheckpointCreator")
  uploadedProposalAssets          ProposalAsset[]                     @relation("ProposalAssetUploader")
  assignedDiagnostics             DiagnosticRequest[]                 @relation("DiagnosticRequestOwner")
  reviewedCustomerAccounts        CustomerAccount[]                   @relation("CustomerAccountReviewer")
  reviewedSicoddCandidates        SicoddImportCandidate[]             @relation("SicoddCandidateReviewer")
  sicoddSyncRuns                  SicoddSyncRun[]                     @relation("SicoddSyncRunRequester")
  updatedSicoddSettings           SicoddSyncSettings[]                @relation("SicoddSettingsUpdater")
  auditEvents                     AdminAuditEvent[]
  googleOAuthAttempts             GoogleOAuthAuthorizationAttempt[]
  connectedDeliveryConfigurations NotificationDeliveryConfiguration[] @relation("DeliveryConfigurationConnectedBy")
  updatedDeliveryConfigurations   NotificationDeliveryConfiguration[] @relation("DeliveryConfigurationUpdatedBy")
  reviewedCommerceOrders          CommerceOrder[]                     @relation("CommerceOrderReviewer")
  cartRecoveries                  CommerceCartRecovery[]              @relation("CommerceCartRecoveryActor")
  updatedPaymentConfigurations    CommercePaymentConfiguration[]      @relation("PaymentConfigurationUpdatedBy")
  reviewedCommercePayments        CommercePayment[]                   @relation("CommercePaymentReviewer")
  verifiedSpeiQuotes              CommerceSpeiQuote[]                 @relation("CommerceSpeiQuoteVerifier")
  updatedSpeiBankAccounts         CommerceSpeiBankAccount[]           @relation("CommerceSpeiBankAccountUpdater")
}

model AdminAuditEvent {
  id        String              @id @default(cuid())
  userId    String
  type      AdminAuditEventType
  metadata  Json?
  createdAt DateTime            @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model NotificationDeliveryConfiguration {
  id                           String                             @id @default(cuid())
  installationKey              String                             @unique @default("default") @db.VarChar(32)
  provider                     NotificationDeliveryProvider       @default(DISABLED)
  providerStatus               NotificationDeliveryProviderStatus @default(NOT_CONFIGURED)
  connectedAccountEmail        String?                            @db.VarChar(320)
  connectedAccountName         String?                            @db.VarChar(255)
  encryptedRefreshToken        String?                            @db.Text
  encryptionVersion            Int?
  grantedScopes                String[]                           @default([])
  senderName                   String?                            @db.VarChar(160)
  senderEmail                  String?                            @db.VarChar(320)
  replyToEmail                 String?                            @db.VarChar(320)
  adminRecipientEmail          String?                            @db.VarChar(320)
  deliveryEnabled              Boolean                            @default(false)
  lastConnectedAt              DateTime?
  lastCheckedAt                DateTime?
  lastSuccessfulTokenRefreshAt DateTime?
  lastSuccessfulSendAt         DateTime?
  lastFailureAt                DateTime?
  lastFailureCode              String?                            @db.VarChar(96)
  connectedByAdminId           String?
  updatedByAdminId             String?
  configurationVersion         Int                                @default(1)
  disconnectedAt               DateTime?
  createdAt                    DateTime                           @default(now())
  updatedAt                    DateTime                           @updatedAt

  connectedByAdmin AdminUser? @relation("DeliveryConfigurationConnectedBy", fields: [connectedByAdminId], references: [id], onDelete: SetNull)
  updatedByAdmin   AdminUser? @relation("DeliveryConfigurationUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
}

model GoogleOAuthAuthorizationAttempt {
  id            String    @id @default(cuid())
  stateHash     String    @unique @db.Char(64)
  nonceHash     String    @db.Char(64)
  adminId       String
  sessionIdHash String    @db.Char(43)
  returnPath    String    @db.VarChar(240)
  expiresAt     DateTime
  consumedAt    DateTime?
  failureCode   String?   @db.VarChar(96)
  createdAt     DateTime  @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([adminId, createdAt])
}

model AdminSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Client {
  id          String   @id @default(cuid())
  companyName String?
  contactName String
  email       String
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects           Project[]
  proposals          Proposal[]
  diagnosticRequests DiagnosticRequest[]
  customerAccount    CustomerAccount?

  @@index([email])
  @@index([companyName])
}

model CustomerAccount {
  id                    String                 @id @default(cuid())
  clientId              String?                @unique
  reviewedById          String?
  companyName           String                 @db.VarChar(160)
  taxId                 String?                @db.VarChar(24)
  contactName           String                 @db.VarChar(160)
  contactRole           String?                @db.VarChar(120)
  contactPhone          String?                @db.VarChar(48)
  purchaseVolume        CustomerPurchaseVolume @default(OCCASIONAL)
  purchaseIntent        String?                @db.VarChar(2000)
  requiresInvoice       Boolean                @default(true)
  status                CustomerAccountStatus  @default(PENDING_EMAIL)
  priceListCode         String?                @db.VarChar(80)
  commercialDiscountPct Decimal?               @db.Decimal(9, 4)
  reviewNotes           String?                @db.VarChar(4000)
  reviewedAt            DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  suspendedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  client                  Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  reviewedBy              AdminUser?               @relation("CustomerAccountReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  users                   CustomerUser[]
  carts                   CommerceCart[]
  orders                  CommerceOrder[]
  payments                CommercePayment[]
  speiQuotes              CommerceSpeiQuote[]
  productEngagementEvents ProductEngagementEvent[]
  enrollmentDocuments     CustomerEnrollmentDocument[]

  @@index([status, updatedAt])
  @@index([companyName])
  @@index([taxId])
}

/// Private supporting files supplied while requesting a customer account.
/// Storage keys never reach public routes; administrators access them through
/// an authenticated download endpoint.
model CustomerEnrollmentDocument {
  id           String   @id @default(cuid())
  accountId    String
  filename     String   @db.VarChar(255)
  storageKey   String   @unique @db.VarChar(512)
  contentType  String   @db.VarChar(120)
  bytes        Int
  createdAt    DateTime @default(now())

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model CustomerUser {
  id              String           @id @default(cuid())
  accountId       String
  email           String           @unique @db.VarChar(320)
  name            String           @db.VarChar(160)
  passwordHash    String?
  role            CustomerUserRole @default(OWNER)
  emailVerifiedAt DateTime?
  isActive        Boolean          @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  account                 CustomerAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  emailVerifications      CustomerEmailVerification[]
  sessions                CustomerSession[]
  requestedCarts          CommerceCart[]
  requestedOrders         CommerceOrder[]             @relation("CommerceOrderRequester")
  requestedPayments       CommercePayment[]           @relation("CommercePaymentRequester")
  issuedSpeiQuotes        CommerceSpeiQuote[]         @relation("CommerceSpeiQuoteIssuer")
  uploadedSpeiProofs      CommerceSpeiPaymentProof[]
  productEngagementEvents ProductEngagementEvent[]

  @@index([accountId, isActive])
}

model CustomerEmailVerification {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user       CustomerUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries CustomerEmailDelivery[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model CustomerEmailDelivery {
  id             String                      @id @default(cuid())
  verificationId String
  status         CustomerEmailDeliveryStatus @default(PENDING)
  attempts       Int                         @default(0)
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  failureSummary String?                     @db.VarChar(1000)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  verification CustomerEmailVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model CustomerSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique @db.Char(64)
  expiresAt     DateTime
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())

  user CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// Durable, privacy-preserving counters for public and authenticated mutation limits.
/// `keyHash` is a SHA-256 digest; raw emails and IP addresses are never persisted.
model RequestRateLimit {
  keyHash     String   @id @db.Char(64)
  windowStart DateTime
  attempts    Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

model SicoddSyncSettings {
  id                        String    @id @default(cuid())
  productListPath           String?   @db.VarChar(512)
  sampleLimit               Int       @default(12)
  includeImages             Boolean   @default(true)
  includeExternalWarehouses Boolean   @default(false)
  importAsDraft             Boolean   @default(true)
  scheduleEnabled           Boolean   @default(false)
  scheduleHour              Int       @default(2)
  scheduleMinute            Int       @default(0)
  scheduledFullSyncLimit    Int?
  updatedById               String?
  lastConnectionAt          DateTime?
  lastConnectionError       String?   @db.VarChar(1000)
  catalogAnalyzedAt         DateTime?
  lastScheduledRunAt        DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  updatedBy AdminUser?      @relation("SicoddSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  runs      SicoddSyncRun[]
}

model SicoddSyncRun {
  id                        String               @id @default(cuid())
  settingsId                String
  requestedById             String?
  type                      SicoddSyncRunType
  trigger                   SicoddSyncRunTrigger @default(MANUAL)
  status                    SicoddSyncRunStatus  @default(QUEUED)
  sequence                  Int?
  productListPath           String?              @db.VarChar(512)
  requestedLimit            Int?
  includeImages             Boolean
  includeExternalWarehouses Boolean
  scope                     Json?
  diagnostics               Json?
  errorSummary              String?              @db.VarChar(2000)
  startedAt                 DateTime             @default(now())
  finishedAt                DateTime?

  settings       SicoddSyncSettings        @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  requestedBy    AdminUser?                @relation("SicoddSyncRunRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  candidates     SicoddImportCandidate[]
  productRecords SicoddSyncProductRecord[]

  @@unique([settingsId, sequence])
  @@index([settingsId, startedAt])
  @@index([status, startedAt])
}

model SicoddSyncProductRecord {
  id                   String                  @id @default(cuid())
  runId                String
  productId            String?
  externalKey          String                  @db.VarChar(220)
  sku                  String?                 @db.VarChar(160)
  result               SicoddSyncProductResult
  changedFields        String[]                @default([])
  previousPriceWithTax Decimal?                @db.Decimal(14, 2)
  nextPriceWithTax     Decimal?                @db.Decimal(14, 2)
  previousCostWithTax  Decimal?                @db.Decimal(14, 2)
  nextCostWithTax      Decimal?                @db.Decimal(14, 2)
  previousStockTotal   Int?
  nextStockTotal       Int?
  imagesDetected       Int                     @default(0)
  imagesQueued         Int                     @default(0)
  imagesSkipped        Int                     @default(0)
  detailsHash          String?                 @db.Char(64)
  errorSummary         String?                 @db.VarChar(1000)
  createdAt            DateTime                @default(now())

  run     SicoddSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([runId, externalKey])
  @@index([runId, result])
  @@index([productId, createdAt])
  @@index([runId, previousPriceWithTax, nextPriceWithTax])
}

model SicoddWarehouse {
  id             String    @id @default(cuid())
  sourceName     String    @db.VarChar(160)
  normalizedName String    @unique @db.VarChar(160)
  nickname       String    @db.VarChar(100)
  notes          String?   @db.VarChar(500)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([lastSeenAt])
}

model SicoddCatalogFamily {
  id            String                     @id @default(cuid())
  code          String                     @unique @db.VarChar(24)
  name          String                     @db.VarChar(160)
  lastSeenAt    DateTime
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  subcategories SicoddCatalogSubcategory[]

  @@index([name])
  @@index([lastSeenAt])
}

model SicoddCatalogSubcategory {
  id         String   @id @default(cuid())
  familyId   String
  code       String   @unique @db.VarChar(24)
  name       String   @db.VarChar(200)
  lastSeenAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  family   SicoddCatalogFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([familyId, name])
  @@index([lastSeenAt])
}

model SicoddImportCandidate {
  id             String                      @id @default(cuid())
  runId          String
  productId      String?                     @unique
  reviewedById   String?
  reviewedAt     DateTime?
  status         SicoddImportCandidateStatus @default(PENDING)
  sourceUrl      String                      @db.VarChar(2048)
  sourceKey      String?                     @db.VarChar(160)
  name           String?                     @db.VarChar(500)
  partNumber     String?                     @db.VarChar(160)
  upc            String?                     @db.VarChar(160)
  warrantyYears  Int?
  description    String?
  imageUrls      Json?
  specifications Json?
  sourcePayload  Json?
  createdAt      DateTime                    @default(now())

  run        SicoddSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product    Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  reviewedBy AdminUser?    @relation("SicoddCandidateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([runId, sourceUrl])
  @@index([partNumber])
  @@index([upc])
  @@index([status, createdAt])
}

model Project {
  id        String        @id @default(cuid())
  clientId  String
  ownerId   String
  title     String
  slug      String        @unique
  summary   String?
  status    ProjectStatus @default(DRAFT)
  isPublic  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner     AdminUser  @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  proposals Proposal[]

  @@index([clientId])
  @@index([ownerId])
  @@index([status, isPublic])
}

model Product {
  id                         String        @id @default(cuid())
  createdById                String
  sku                        String        @unique
  slug                       String        @unique
  name                       String
  brand                      String?
  category                   String
  description                String
  specifications             Json?
  imageUrl                   String?
  galleryUrls                Json?
  imageFrameColors           Json?
  partNumber                 String?       @db.VarChar(160)
  upc                        String?       @db.VarChar(160)
  warrantyYears              Int?
  stockTotal                 Int?
  stockByLocation            Json?
  stockUpdatedAt             DateTime?
  supplierCostWithTax        Decimal?      @db.Decimal(14, 2)
  basePriceWithTax           Decimal?      @db.Decimal(14, 2)
  volumePrices               Json?
  supplierSourceUrl          String?       @db.VarChar(2048)
  supplierSourceKey          String?       @db.VarChar(160)
  supplierSubcategoryId      String?
  supplierDetailsHash        String?       @db.Char(64)
  supplierSourceEtag         String?       @db.VarChar(255)
  supplierSourceModifiedAt   String?       @db.VarChar(255)
  supplierImagesHash         String?       @db.Char(64)
  supplierSpecificationsHash String?       @db.Char(64)
  supplierSourcePayload      Json?
  supplierLastSyncedAt       DateTime?
  supplierLastSeenAt         DateTime?
  specialOrder               Boolean       @default(false)
  status                     ProductStatus @default(DRAFT)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  createdBy               AdminUser                 @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Restrict)
  importCandidate         SicoddImportCandidate?
  cartItems               CommerceCartItem[]
  orderItems              CommerceOrderItem[]
  speiQuoteItems          CommerceSpeiQuoteItem[]
  imageDerivatives        ProductImageDerivative[]
  imageExclusions         ProductImageExclusion[]
  productEngagementEvents ProductEngagementEvent[]
  sicoddSyncRecords       SicoddSyncProductRecord[]
  supplierSubcategory     SicoddCatalogSubcategory? @relation(fields: [supplierSubcategoryId], references: [id], onDelete: SetNull)

  @@index([category, status])
  @@index([status, updatedAt])
  @@index([upc])
  @@index([partNumber])
  @@index([supplierSourceKey])
  @@index([supplierSubcategoryId, status])
  @@index([supplierLastSyncedAt])
}

model ProductImageDerivative {
  id                String                       @id @default(cuid())
  productId         String
  sourceUrl         String                       @db.VarChar(2048)
  sourceUrlHash     String                       @db.Char(64)
  sourcePosition    Int                          @default(0)
  sourceHash        String?                      @db.Char(64)
  sourceEtag        String?                      @db.VarChar(255)
  sourceModifiedAt  String?                      @db.VarChar(255)
  status            ProductImageProcessingStatus @default(PENDING)
  attempts          Int                          @default(0)
  maxAttempts       Int                          @default(3)
  nextAttemptAt     DateTime                     @default(now())
  lockedAt          DateTime?
  lockedBy          String?                      @db.VarChar(120)
  modelName         String?                      @db.VarChar(160)
  modelRevision     String?                      @db.VarChar(160)
  processingVersion Int                          @default(1)
  storageKey        String?                      @db.VarChar(512)
  pngBytes          Int?
  width             Int?
  height            Int?
  processedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  lastErrorCode     String?                      @db.VarChar(80)
  lastErrorMessage  String?                      @db.VarChar(1000)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser? @relation("ProductImageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([productId, sourceUrlHash])
  @@index([status, nextAttemptAt, createdAt])
  @@index([productId, status, sourcePosition])
  @@index([reviewedById])
}

model CommerceCart {
  id            String             @id @default(cuid())
  accountId     String
  status        CommerceCartStatus @default(ACTIVE)
  reference     String?            @unique @db.VarChar(48)
  requestedById String?
  requestedAt   DateTime?
  customerNotes String?            @db.VarChar(2000)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  account     CustomerAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  requestedBy CustomerUser?         @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  items       CommerceCartItem[]
  order       CommerceOrder?        @relation("CommerceOrderSourceQuote")
  recovery    CommerceCartRecovery?

  @@index([accountId, status, updatedAt])
  @@index([status, requestedAt])
  @@index([status, updatedAt])
}

model CommerceCartRecovery {
  id                String                     @id @default(cuid())
  cartId            String                     @unique
  status            CommerceCartRecoveryStatus @default(OPEN)
  adminNotes        String?                    @db.VarChar(2000)
  lastContactedAt   DateTime?
  lastContactedById String?
  dismissedAt       DateTime?
  convertedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  cart            CommerceCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  lastContactedBy AdminUser?   @relation("CommerceCartRecoveryActor", fields: [lastContactedById], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([lastContactedById, updatedAt])
}

model ProductEngagementEvent {
  id                String                     @id @default(cuid())
  productId         String
  accountId         String?
  customerUserId    String?
  eventType         ProductEngagementEventType
  sessionHash       String?                    @db.Char(64)
  galleryImageCount Int?
  createdAt         DateTime                   @default(now())

  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  account      CustomerAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  customerUser CustomerUser?    @relation(fields: [customerUserId], references: [id], onDelete: SetNull)

  @@index([productId, eventType, createdAt])
  @@index([accountId, createdAt])
  @@index([customerUserId, createdAt])
  @@index([createdAt])
}

model CommerceCartItem {
  id                       String    @id @default(cuid())
  cartId                   String
  productId                String
  quantity                 Int       @default(1)
  snapshotName             String?
  snapshotSku              String?   @db.VarChar(80)
  snapshotBrand            String?   @db.VarChar(100)
  snapshotUnitPriceWithTax Decimal?  @db.Decimal(14, 2)
  snapshotDiscountPct      Decimal?  @db.Decimal(9, 4)
  snapshotStockTotal       Int?
  snapshotAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  cart    CommerceCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
}

model ProductImageExclusion {
  id                String   @id @default(cuid())
  productId         String
  sourceUrl         String   @db.VarChar(2048)
  sourceUrlHash     String   @db.Char(64)
  sourceContentHash String?  @db.Char(64)
  reason            String?  @db.VarChar(500)
  createdById       String?
  createdAt         DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy AdminUser? @relation("ProductImageExclusionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([productId, sourceUrlHash])
  @@index([productId, createdAt])
  @@index([sourceContentHash])
}

model CommerceOrder {
  id            String                     @id @default(cuid())
  accountId     String
  sourceQuoteId String?                    @unique
  requestedById String?
  reviewedById  String?
  reference     String                     @unique @db.VarChar(48)
  status        CommerceOrderStatus        @default(REQUESTED)
  paymentStatus CommerceOrderPaymentStatus @default(UNPAID)
  paymentMethod CommercePaymentProvider?
  customerNotes String?                    @db.VarChar(2000)
  adminNotes    String?                    @db.VarChar(4000)
  requestedAt   DateTime                   @default(now())
  reviewedAt    DateTime?
  confirmedAt   DateTime?
  fulfilledAt   DateTime?
  cancelledAt   DateTime?
  paidAt        DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  account     CustomerAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourceQuote CommerceCart?       @relation("CommerceOrderSourceQuote", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  requestedBy CustomerUser?       @relation("CommerceOrderRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy  AdminUser?          @relation("CommerceOrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  items       CommerceOrderItem[]
  payments    CommercePayment[]
  speiQuotes  CommerceSpeiQuote[]

  @@index([accountId, status, updatedAt])
  @@index([accountId, paymentStatus, updatedAt])
  @@index([status, requestedAt])
  @@index([paymentStatus, updatedAt])
  @@index([requestedById])
}

model CommerceOrderItem {
  id                       String    @id @default(cuid())
  orderId                  String
  productId                String
  quantity                 Int
  snapshotName             String?
  snapshotSku              String?   @db.VarChar(80)
  snapshotBrand            String?   @db.VarChar(100)
  snapshotUnitPriceWithTax Decimal?  @db.Decimal(14, 2)
  snapshotDiscountPct      Decimal?  @db.Decimal(9, 4)
  snapshotStockTotal       Int?
  snapshotAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  order   CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
}

/**
 * Global kill switch and non-secret commercial payment settings. Credentials stay in env.
 */
model CommercePaymentConfiguration {
  id                       String   @id @default(cuid())
  installationKey          String   @unique @default("default") @db.VarChar(32)
  paymentsEnabled          Boolean  @default(false)
  mercadoPagoEnabled       Boolean  @default(false)
  mercadoPagoSandbox       Boolean  @default(true)
  speiEnabled              Boolean  @default(false)
  speiDiscountPct          Decimal  @default(0) @db.Decimal(9, 4)
  speiQuoteExpirationHours Int      @default(24)
  sellerName               String   @default("JANVIER") @db.VarChar(160)
  sellerContact            String?  @db.VarChar(320)
  sellerTerms              String?  @db.VarChar(2000)
  updatedById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  updatedBy AdminUser? @relation("PaymentConfigurationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/**
 * Bank details are server-managed and are released only inside an active SPEI quote.
 */
model CommerceSpeiBankAccount {
  id            String   @id @default(cuid())
  alias         String   @db.VarChar(80)
  bankName      String   @db.VarChar(120)
  beneficiary   String   @db.VarChar(160)
  accountNumber String?  @db.VarChar(40)
  clabe         String?  @db.VarChar(18)
  accountType   String   @default("CUENTA") @db.VarChar(40)
  currency      String   @default("MXN") @db.VarChar(3)
  isActive      Boolean  @default(true)
  priority      Int      @default(0)
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  updatedBy  AdminUser?          @relation("CommerceSpeiBankAccountUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  speiQuotes CommerceSpeiQuote[]

  @@unique([alias, currency])
  @@index([isActive, priority])
}

/**
 * A server-verified payment attempt. No card number, CVV, or token is persisted.
 */
model CommercePayment {
  id                   String                  @id @default(cuid())
  orderId              String
  accountId            String
  requestedById        String?
  speiQuoteId          String?                 @unique
  provider             CommercePaymentProvider
  status               CommercePaymentStatus   @default(DRAFT)
  amount               Decimal                 @db.Decimal(14, 2)
  currency             String                  @default("MXN") @db.VarChar(3)
  externalReference    String                  @unique @db.VarChar(64)
  idempotencyKey       String                  @unique @db.VarChar(128)
  providerOrderId      String?                 @unique @db.VarChar(160)
  providerPaymentId    String?                 @unique @db.VarChar(160)
  providerStatus       String?                 @db.VarChar(80)
  providerStatusDetail String?                 @db.VarChar(160)
  paymentMethodId      String?                 @db.VarChar(80)
  paymentMethodType    String?                 @db.VarChar(80)
  expiresAt            DateTime?
  reportedAt           DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  refundedAt           DateTime?
  chargedBackAt        DateTime?
  lastWebhookAt        DateTime?
  reviewedById         String?
  reviewNotes          String?                 @db.VarChar(2000)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  order       CommerceOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  account     CustomerAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  requestedBy CustomerUser?            @relation("CommercePaymentRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  speiQuote   CommerceSpeiQuote?       @relation(fields: [speiQuoteId], references: [id], onDelete: SetNull)
  reviewedBy  AdminUser?               @relation("CommercePaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  events      CommercePaymentEvent[]
  webhooks    CommercePaymentWebhook[]

  @@index([orderId, status, createdAt])
  @@index([accountId, status, updatedAt])
  @@index([provider, status, updatedAt])
  @@index([status, expiresAt])
}

/**
 * Immutable SPEI commercial document. Its products and economic fields never read catalog prices.
 */
model CommerceSpeiQuote {
  id                  String                  @id @default(cuid())
  orderId             String
  accountId           String
  issuedById          String?
  bankAccountId       String
  reference           String                  @unique @db.VarChar(48)
  status              CommerceSpeiQuoteStatus @default(ISSUED)
  currency            String                  @default("MXN") @db.VarChar(3)
  subtotal            Decimal                 @db.Decimal(14, 2)
  totalBeforeDiscount Decimal                 @db.Decimal(14, 2)
  discountPercentage  Decimal                 @db.Decimal(9, 4)
  discountAmount      Decimal                 @db.Decimal(14, 2)
  total               Decimal                 @db.Decimal(14, 2)
  sellerName          String                  @db.VarChar(160)
  sellerContact       String?                 @db.VarChar(320)
  sellerTerms         String?                 @db.VarChar(2000)
  customerCompanyName String                  @db.VarChar(160)
  customerContactName String                  @db.VarChar(160)
  customerEmail       String                  @db.VarChar(320)
  bankAccountSnapshot Json
  issuedAt            DateTime                @default(now())
  expiresAt           DateTime
  paymentReportedAt   DateTime?
  paymentVerifiedAt   DateTime?
  cancelledAt         DateTime?
  refundedAt          DateTime?
  verifiedById        String?
  pdfStorageKey       String?                 @unique @db.VarChar(512)
  pdfSha256           String?                 @db.Char(64)
  pdfGeneratedAt      DateTime?
  pdfGenerationError  String?                 @db.VarChar(500)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  order       CommerceOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  account     CustomerAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  issuedBy    CustomerUser?              @relation("CommerceSpeiQuoteIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  bankAccount CommerceSpeiBankAccount    @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  verifiedBy  AdminUser?                 @relation("CommerceSpeiQuoteVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  items       CommerceSpeiQuoteItem[]
  payment     CommercePayment?
  proofs      CommerceSpeiPaymentProof[]

  @@index([orderId, status, issuedAt])
  @@index([accountId, status, updatedAt])
  @@index([status, expiresAt])
}

model CommerceSpeiQuoteItem {
  id        String   @id @default(cuid())
  quoteId   String
  productId String
  quantity  Int
  name      String?  @db.VarChar(1000)
  sku       String?  @db.VarChar(80)
  brand     String?  @db.VarChar(100)
  unitPrice Decimal  @db.Decimal(14, 2)
  lineTotal Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  quote   CommerceSpeiQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([quoteId, productId])
  @@index([productId])
}

model CommerceSpeiPaymentProof {
  id               String   @id @default(cuid())
  quoteId          String
  uploadedById     String
  originalFileName String   @db.VarChar(255)
  mimeType         String   @db.VarChar(80)
  sizeBytes        Int
  sha256           String   @db.Char(64)
  storageKey       String   @unique @db.VarChar(512)
  createdAt        DateTime @default(now())

  quote      CommerceSpeiQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  uploadedBy CustomerUser      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
}

model CommercePaymentEvent {
  id              String                   @id @default(cuid())
  paymentId       String
  type            CommercePaymentEventType
  previousStatus  CommercePaymentStatus?
  nextStatus      CommercePaymentStatus?
  providerEventId String?                  @unique @db.VarChar(200)
  summary         String?                  @db.VarChar(1000)
  createdAt       DateTime                 @default(now())

  payment CommercePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([type, createdAt])
}

/**
 * Deduplicates authentic webhook deliveries without persisting cardholder data or raw payloads.
 */
model CommercePaymentWebhook {
  id              String                  @id @default(cuid())
  paymentId       String?
  provider        CommercePaymentProvider
  deliveryKey     String                  @unique @db.VarChar(200)
  resourceId      String                  @db.VarChar(160)
  topic           String?                 @db.VarChar(80)
  action          String?                 @db.VarChar(160)
  verified        Boolean                 @default(false)
  receivedAt      DateTime                @default(now())
  processedAt     DateTime?
  processingError String?                 @db.VarChar(500)

  payment CommercePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([provider, receivedAt])
  @@index([paymentId, receivedAt])
}

model Proposal {
  id               String         @id @default(cuid())
  reference        String         @unique
  clientId         String
  projectId        String?
  ownerId          String
  title            String
  status           ProposalStatus @default(DRAFT)
  selectedOptionId String?
  currency         String         @default("MXN") @db.VarChar(3)
  validUntil       DateTime?
  sentAt           DateTime?
  firstViewedAt    DateTime?
  acceptedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  client            Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project           Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner             AdminUser           @relation("ProposalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  selectedOption    ProposalOption?     @relation("ProposalSelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)
  revisions         ProposalRevision[]
  invites           ProposalInvite[]
  comments          ProposalComment[]
  decisions         ProposalDecision[]
  acceptance        ProposalAcceptance?
  events            ProposalEvent[]
  diagnosticRequest DiagnosticRequest?

  @@index([clientId, status])
  @@index([projectId])
  @@index([ownerId])
  @@index([validUntil])
  @@index([selectedOptionId])
}

model DiagnosticRequest {
  id                 String                  @id @default(cuid())
  status             DiagnosticRequestStatus @default(NEW)
  source             DiagnosticRequestSource @default(CONTACT_FORM)
  contactName        String                  @db.VarChar(160)
  email              String                  @db.VarChar(320)
  phone              String?                 @db.VarChar(48)
  companyName        String?                 @db.VarChar(160)
  service            String                  @db.VarChar(120)
  timeline           String?                 @db.VarChar(120)
  budgetRange        String?                 @db.VarChar(120)
  message            String                  @db.VarChar(6000)
  privateNotes       String?                 @db.VarChar(4000)
  requestFingerprint String?                 @db.Char(64)
  clientId           String?
  proposalId         String?                 @unique
  ownerId            String?
  contactedAt        DateTime?
  qualifiedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  client   Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  proposal Proposal?  @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  owner    AdminUser? @relation("DiagnosticRequestOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([email, createdAt])
  @@index([requestFingerprint, createdAt])
  @@index([ownerId, status])
}

model WebAnalyticsEvent {
  id             String                @id @default(cuid())
  eventType      WebAnalyticsEventType
  sessionHash    String                @db.Char(64)
  path           String                @db.VarChar(240)
  target         String?               @db.VarChar(160)
  referrerOrigin String?               @db.VarChar(255)
  viewport       String?               @db.VarChar(24)
  theme          String?               @db.VarChar(16)
  createdAt      DateTime              @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([path, createdAt])
  @@index([sessionHash, createdAt])
}

model ProposalRevision {
  id                           String                 @id @default(cuid())
  proposalId                   String
  authorId                     String
  revision                     Int
  title                        String
  introduction                 String?
  terms                        String?
  investment                   Decimal?               @db.Decimal(12, 2)
  taxIncluded                  Boolean                @default(false)
  // Commercial data is revision-scoped. Legacy Proposal fields remain intact
  // for V1 snapshots and the existing Project Room until the later freeze work.
  commercialVersion            Int                    @default(1)
  commercialCalculationVersion String                 @default("janvier-commercial-v1") @db.VarChar(48)
  currency                     String                 @default("MXN") @db.VarChar(3)
  validUntil                   DateTime?
  taxDisplayMode               ProposalTaxDisplayMode @default(EXCLUSIVE)
  paymentTermsSummary          String?                @db.VarChar(1000)
  deliveryTerms                String?                @db.VarChar(2000)
  warrantySummary              String?                @db.VarChar(2000)
  supportSummary               String?                @db.VarChar(2000)
  resolvedVariables            Json?
  frozenPublicDocument         Json?
  frozenPrivateEvidence        Json?
  publicContentHash            String?                @db.Char(64)
  evidenceHash                 String?                @db.Char(64)
  frozenAt                     DateTime?
  sharedAt                     DateTime?
  lockedAt                     DateTime?
  replacedAt                   DateTime?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt

  proposal                  Proposal                 @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  author                    AdminUser                @relation("RevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  sections                  ProposalSection[]
  options                   ProposalOption[]
  lineItems                 ProposalLineItem[]
  invites                   ProposalInvite[]
  comments                  ProposalComment[]
  decisions                 ProposalDecision[]
  acceptances               ProposalAcceptance[]
  events                    ProposalEvent[]
  markdownSource            ProposalMarkdownSource?  @relation("MarkdownSourceCurrent")
  markdownSourceDescendants ProposalMarkdownSource[] @relation("MarkdownSourceOrigin")
  assets                    ProposalAsset[]
  timelinePhases            ProposalTimelinePhase[]
  paymentStages             ProposalPaymentStage[]

  @@unique([proposalId, revision])
  @@index([proposalId, sharedAt])
  @@index([publicContentHash])
}

model ProposalSection {
  id              String              @id @default(cuid())
  revisionId      String
  sourceId        String              @default(cuid()) @db.VarChar(64)
  slug            String              @default(cuid()) @db.VarChar(96)
  type            ProposalSectionType @default(CUSTOM)
  position        Int
  title           String
  content         String?
  contentAst      Json?
  metadata        Json?
  isIncluded      Boolean             @default(true)
  internalOnly    Boolean             @default(false)
  sourceStartLine Int?
  sourceEndLine   Int?
  removedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  revision ProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, position])
  @@unique([revisionId, sourceId])
  @@unique([revisionId, slug])
  @@index([revisionId, type])
  @@index([revisionId, removedAt])
}

model ProposalMarkdownSource {
  id                String                      @id @default(cuid())
  revisionId        String                      @unique
  sourceRevisionId  String?
  originalFileName  String?                     @db.VarChar(255)
  sourceMarkdown    String                      @db.Text
  sourceHash        String                      @db.Char(64)
  encoding          String                      @default("UTF-8") @db.VarChar(16)
  parserVersion     String                      @db.VarChar(32)
  version           Int                         @default(1)
  parseStatus       ProposalMarkdownParseStatus
  parseWarnings     Json?
  normalizedAst     Json?
  importedAt        DateTime                    @default(now())
  importedByAdminId String
  lastParsedAt      DateTime                    @default(now())
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  revision       ProposalRevision             @relation("MarkdownSourceCurrent", fields: [revisionId], references: [id], onDelete: Cascade)
  sourceRevision ProposalRevision?            @relation("MarkdownSourceOrigin", fields: [sourceRevisionId], references: [id], onDelete: SetNull)
  importedBy     AdminUser                    @relation("MarkdownSourceImporter", fields: [importedByAdminId], references: [id], onDelete: Restrict)
  checkpoints    ProposalMarkdownCheckpoint[]

  @@index([sourceRevisionId])
  @@index([importedByAdminId])
}

model ProposalMarkdownCheckpoint {
  id               String                           @id @default(cuid())
  sourceId         String
  sequence         Int
  reason           ProposalMarkdownCheckpointReason
  sourceMarkdown   String                           @db.Text
  sourceHash       String                           @db.Char(64)
  parserVersion    String                           @db.VarChar(32)
  parseStatus      ProposalMarkdownParseStatus
  parseWarnings    Json?
  originalFileName String?                          @db.VarChar(255)
  createdByAdminId String
  createdAt        DateTime                         @default(now())

  source             ProposalMarkdownSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdBy          AdminUser              @relation("MarkdownCheckpointCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  acceptanceEvidence ProposalAcceptance[]   @relation("AcceptanceEvidenceCheckpoint")

  @@unique([sourceId, sequence])
  @@index([sourceId, createdAt])
  @@index([createdByAdminId])
}

model ProposalAssetBlob {
  id         String   @id @default(cuid())
  storageKey String   @unique @db.VarChar(512)
  sha256     String   @unique @db.Char(64)
  mimeType   String   @db.VarChar(128)
  sizeBytes  Int
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  references ProposalAsset[]
}

model ProposalAsset {
  id                String    @id @default(cuid())
  revisionId        String
  blobId            String
  alias             String    @db.VarChar(80)
  originalFileName  String    @db.VarChar(255)
  altText           String    @db.VarChar(500)
  isRequired        Boolean   @default(false)
  isDecorative      Boolean   @default(false)
  uploadedByAdminId String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  removedAt         DateTime?

  revision   ProposalRevision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  blob       ProposalAssetBlob @relation(fields: [blobId], references: [id], onDelete: Restrict)
  uploadedBy AdminUser         @relation("ProposalAssetUploader", fields: [uploadedByAdminId], references: [id], onDelete: Restrict)

  @@unique([revisionId, alias])
  @@index([blobId])
  @@index([revisionId, removedAt])
}

model ProposalOption {
  id                String    @id @default(cuid())
  revisionId        String
  code              String
  position          Int
  title             String
  description       String?
  investment        Decimal?  @db.Decimal(12, 2)
  taxIncluded       Boolean   @default(false)
  recommended       Boolean   @default(false)
  isEnabled         Boolean   @default(true)
  isActive          Boolean   @default(true)
  estimatedDuration String?   @db.VarChar(160)
  supportSummary    String?   @db.VarChar(1000)
  conditionsSummary String?   @db.VarChar(1000)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  revision            ProposalRevision        @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  lineItems           ProposalLineItem[]
  timelinePhases      ProposalTimelinePhase[]
  paymentStages       ProposalPaymentStage[]
  selectedByProposals Proposal[]              @relation("ProposalSelectedOption")
  acceptances         ProposalAcceptance[]

  @@unique([revisionId, code])
  @@unique([revisionId, position])
}

model ProposalLineItem {
  id                 String                @id @default(cuid())
  revisionId         String
  optionId           String?
  code               String
  name               String                @default("Concepto") @db.VarChar(255)
  description        String
  quantity           Decimal               @default(1) @db.Decimal(18, 4)
  unit               String                @default("service") @db.VarChar(40)
  billingType        ProposalLineItemType  @default(ONE_TIME)
  unitPrice          Decimal               @db.Decimal(18, 2)
  discount           Decimal               @default(0) @db.Decimal(12, 2)
  discountType       ProposalDiscountType  @default(NONE)
  discountValue      Decimal               @default(0) @db.Decimal(18, 2)
  taxRate            Decimal               @default(0) @db.Decimal(9, 4)
  isTaxable          Boolean               @default(true)
  taxIncluded        Boolean               @default(false)
  type               ProposalLineItemType  @default(ONE_TIME)
  position           Int
  scope              ProposalLineItemScope @default(OPTION_SPECIFIC)
  isOptional         Boolean               @default(false)
  selectedByDefault  Boolean               @default(false)
  isIncluded         Boolean               @default(false)
  isActive           Boolean               @default(true)
  visibleForClient   Boolean               @default(true)
  visibleToClient    Boolean               @default(true)
  pricingMode        ProposalPricingMode   @default(MANUAL)
  internalCost       Decimal?              @db.Decimal(18, 2)
  markupPercent      Decimal?              @db.Decimal(9, 4)
  contingencyPercent Decimal?              @db.Decimal(9, 4)
  supplier           String?               @db.VarChar(255)
  supplierReference  String?               @db.VarChar(255)
  internalNotes      String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  removedAt          DateTime?

  revision ProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  option   ProposalOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([revisionId, position])
  @@unique([revisionId, code])
  @@index([revisionId, optionId])
  @@index([revisionId, removedAt])
}

model ProposalTimelinePhase {
  id                 String                       @id @default(cuid())
  revisionId         String
  optionId           String?
  code               String                       @db.VarChar(80)
  title              String                       @db.VarChar(255)
  description        String?                      @db.VarChar(4000)
  position           Int
  durationValue      Int
  durationUnit       ProposalTimelineDurationUnit
  estimatedStartDate DateTime?
  estimatedEndDate   DateTime?
  isOptional         Boolean                      @default(false)
  visibleToClient    Boolean                      @default(true)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  revision     ProposalRevision              @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  option       ProposalOption?               @relation(fields: [optionId], references: [id], onDelete: SetNull)
  deliverables ProposalTimelineDeliverable[]
  dependencies ProposalTimelineDependency[]  @relation("ProposalTimelineDependencyPhase")
  dependedOnBy ProposalTimelineDependency[]  @relation("ProposalTimelineDependencyPrerequisite")

  @@unique([revisionId, code])
  @@unique([revisionId, position])
  @@index([revisionId, optionId])
}

model ProposalTimelineDependency {
  id               String   @id @default(cuid())
  phaseId          String
  dependsOnPhaseId String
  createdAt        DateTime @default(now())

  phase          ProposalTimelinePhase @relation("ProposalTimelineDependencyPhase", fields: [phaseId], references: [id], onDelete: Cascade)
  dependsOnPhase ProposalTimelinePhase @relation("ProposalTimelineDependencyPrerequisite", fields: [dependsOnPhaseId], references: [id], onDelete: Restrict)

  @@unique([phaseId, dependsOnPhaseId])
  @@index([dependsOnPhaseId])
}

model ProposalTimelineDeliverable {
  id              String  @id @default(cuid())
  phaseId         String
  title           String  @db.VarChar(255)
  description     String? @db.VarChar(4000)
  position        Int
  visibleToClient Boolean @default(true)

  phase ProposalTimelinePhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([phaseId, position])
  @@index([phaseId])
}

model ProposalPaymentStage {
  id                 String                         @id @default(cuid())
  revisionId         String
  optionId           String?
  title              String                         @db.VarChar(255)
  description        String?                        @db.VarChar(2000)
  position           Int
  calculationType    ProposalPaymentCalculationType
  percentage         Decimal?                       @db.Decimal(9, 4)
  fixedAmount        Decimal?                       @db.Decimal(18, 2)
  triggerType        ProposalPaymentTriggerType
  triggerDescription String?                        @db.VarChar(1000)
  dueDays            Int?
  visibleToClient    Boolean                        @default(true)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  revision ProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  option   ProposalOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([revisionId, position])
  @@index([revisionId, optionId])
}

model ProposalInvite {
  id             String               @id @default(cuid())
  proposalId     String
  revisionId     String
  createdById    String
  tokenHash      String               @unique
  codeHash       String
  recipientEmail String?
  status         ProposalInviteStatus @default(ACTIVE)
  expiresAt      DateTime
  revokedAt      DateTime?
  firstViewedAt  DateTime?
  lastViewedAt   DateTime?
  viewCount      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  proposal    Proposal                @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revision    ProposalRevision        @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  createdBy   AdminUser               @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments    ProposalComment[]
  decisions   ProposalDecision[]
  attempts    ProposalInviteAttempt[]
  viewers     ProposalInviteViewer[]
  views       ProposalInviteView[]
  acceptances ProposalAcceptance[]

  @@index([proposalId, status])
  @@index([revisionId])
  @@index([expiresAt])
}

model ProposalInviteAttempt {
  id        String   @id @default(cuid())
  inviteId  String
  createdAt DateTime @default(now())

  invite ProposalInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([inviteId, createdAt])
}

model ProposalInviteViewer {
  id            String    @id @default(cuid())
  inviteId      String
  name          String    @db.VarChar(160)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  invite ProposalInvite       @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  views  ProposalInviteView[]

  @@index([inviteId, lastViewedAt])
  @@index([inviteId, name])
}

model ProposalInviteView {
  id        String   @id @default(cuid())
  inviteId  String
  viewerId  String
  ip        String?  @db.VarChar(96)
  userAgent String?  @db.VarChar(1000)
  createdAt DateTime @default(now())

  invite ProposalInvite       @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  viewer ProposalInviteViewer @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@index([inviteId, createdAt])
  @@index([viewerId, createdAt])
}

model ProposalComment {
  id            String   @id @default(cuid())
  proposalId    String
  revisionId    String
  inviteId      String?
  adminAuthorId String?
  authorName    String
  authorEmail   String?
  content       String
  isInternal    Boolean  @default(false)
  createdAt     DateTime @default(now())

  proposal    Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revision    ProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  invite      ProposalInvite?  @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  adminAuthor AdminUser?       @relation("AdminCommentAuthor", fields: [adminAuthorId], references: [id], onDelete: SetNull)

  @@index([proposalId, createdAt])
  @@index([revisionId, createdAt])
}

model ProposalDecision {
  id              String               @id @default(cuid())
  proposalId      String
  revisionId      String
  inviteId        String?
  type            ProposalDecisionType
  actorName       String
  actorEmail      String?
  note            String?
  acceptedTermsAt DateTime?
  createdAt       DateTime             @default(now())

  proposal Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revision ProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  invite   ProposalInvite?  @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@index([proposalId, createdAt])
  @@index([revisionId, createdAt])
}

model ProposalAcceptance {
  id                 String                     @id @default(cuid())
  proposalId         String                     @unique
  revisionId         String
  optionId           String?
  inviteId           String
  name               String
  email              String
  role               String
  company            String?
  ip                 String?
  userAgent          String?
  currency           String                     @db.VarChar(3)
  subtotal           Decimal                    @db.Decimal(12, 2)
  tax                Decimal                    @db.Decimal(12, 2)
  total              Decimal                    @db.Decimal(12, 2)
  terms              String?
  snapshot           Json
  contentHash        String
  snapshotVersion    String                     @default("project-room-v1") @db.VarChar(48)
  publicContentHash  String?                    @db.Char(64)
  evidenceHash       String?                    @db.Char(64)
  sourceCheckpointId String?
  verificationMethod ProposalVerificationMethod
  createdAt          DateTime                   @default(now())

  proposal         Proposal                    @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  revision         ProposalRevision            @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  option           ProposalOption?             @relation(fields: [optionId], references: [id], onDelete: Restrict)
  invite           ProposalInvite              @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  sourceCheckpoint ProposalMarkdownCheckpoint? @relation("AcceptanceEvidenceCheckpoint", fields: [sourceCheckpointId], references: [id], onDelete: Restrict)

  @@index([revisionId])
  @@index([inviteId])
  @@index([contentHash])
  @@index([publicContentHash])
  @@index([sourceCheckpointId])
}

model ProposalEvent {
  id           String            @id @default(cuid())
  proposalId   String
  revisionId   String?
  adminActorId String?
  type         ProposalEventType
  metadata     Json?
  createdAt    DateTime          @default(now())

  proposal    Proposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revision    ProposalRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  adminActor  AdminUser?        @relation("EventAdminActor", fields: [adminActorId], references: [id], onDelete: SetNull)
  emailOutbox EmailOutbox[]

  @@index([proposalId, createdAt])
  @@index([revisionId, createdAt])
}

model EmailOutbox {
  id               String                @id @default(cuid())
  kind             EmailNotificationKind
  status           EmailOutboxStatus     @default(PENDING)
  priority         Int                   @default(0)
  recipient        String                @db.VarChar(320)
  subject          String                @db.VarChar(255)
  html             String                @db.Text
  text             String                @db.Text
  dedupeKey        String                @unique @db.VarChar(255)
  proposalEventId  String?
  attempts         Int                   @default(0)
  maxAttempts      Int                   @default(5)
  nextAttemptAt    DateTime              @default(now())
  lockedAt         DateTime?
  lockedBy         String?               @db.VarChar(96)
  recoveries       Int                   @default(0)
  lastErrorCode    String?               @db.VarChar(64)
  lastErrorMessage String?               @db.VarChar(2000)
  sentAt           DateTime?
  failedAt         DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  proposalEvent ProposalEvent? @relation(fields: [proposalEventId], references: [id], onDelete: SetNull)

  @@index([status, priority, nextAttemptAt])
  @@index([status, lockedAt])
  @@index([createdAt])
  @@index([proposalEventId])
}
