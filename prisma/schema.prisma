generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  OWNER
  ADMIN
  EDITOR
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  CHANGES_REQUESTED
  ACCEPTED
  DECLINED
  EXPIRED
  REPLACED
}

enum ProposalInviteStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ProposalSectionType {
  CONTEXT
  SCOPE
  DELIVERABLES
  TIMELINE
  INVESTMENT
  TERMS
  REFERENCE
  CUSTOM
}

enum ProposalDecisionType {
  ACCEPT
  REQUEST_CHANGES
  DECLINE
}

enum ProposalEventType {
  CREATED
  REVISION_CREATED
  INVITED
  VIEWED
  COMMENTED
  DECIDED
  REVOKED
  EXPIRED
  PROPOSAL_CREATED
  PROPOSAL_EDITED
  REVISION_SHARED
  INVITE_CREATED
  INVITE_VIEWED
  OPTION_SELECTED
  COMMENT_CREATED
  CHANGES_REQUESTED
  PROPOSAL_ACCEPTED
  PROPOSAL_DECLINED
  INVITE_REVOKED
  PROJECT_CREATED
}

enum ProposalLineItemType {
  ONE_TIME
  MONTHLY
  ANNUAL
  INCLUDED
  OPTIONAL
}

enum ProposalVerificationMethod {
  INVITE_CODE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdProjects  Project[]          @relation("ProjectOwner")
  createdProposals Proposal[]         @relation("ProposalOwner")
  revisions        ProposalRevision[] @relation("RevisionAuthor")
  comments         ProposalComment[]  @relation("AdminCommentAuthor")
  events           ProposalEvent[]    @relation("EventAdminActor")
  invites          ProposalInvite[]   @relation("InviteCreator")
  sessions         AdminSession[]
  products         Product[]          @relation("ProductCreator")
}

model AdminSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Client {
  id          String   @id @default(cuid())
  companyName String?
  contactName String
  email       String
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects  Project[]
  proposals Proposal[]

  @@index([email])
  @@index([companyName])
}

model Project {
  id        String        @id @default(cuid())
  clientId  String
  ownerId   String
  title     String
  slug      String        @unique
  summary   String?
  status    ProjectStatus @default(DRAFT)
  isPublic  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner     AdminUser  @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  proposals Proposal[]

  @@index([clientId])
  @@index([ownerId])
  @@index([status, isPublic])
}

model Product {
  id             String        @id @default(cuid())
  createdById    String
  sku            String        @unique
  slug           String        @unique
  name           String
  brand          String?
  category       String
  description    String
  specifications Json?
  imageUrl       String?
  specialOrder   Boolean       @default(false)
  status         ProductStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  createdBy AdminUser @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([category, status])
  @@index([status, updatedAt])
}

model Proposal {
  id            String         @id @default(cuid())
  reference     String         @unique
  clientId      String
  projectId     String?
  ownerId       String
  title         String
  status        ProposalStatus @default(DRAFT)
  selectedOptionId String?
  currency      String         @default("MXN") @db.VarChar(3)
  validUntil    DateTime?
  sentAt        DateTime?
  firstViewedAt DateTime?
  acceptedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  client    Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner     AdminUser          @relation("ProposalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  selectedOption ProposalOption? @relation("ProposalSelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)
  revisions ProposalRevision[]
  invites   ProposalInvite[]
  comments  ProposalComment[]
  decisions ProposalDecision[]
  acceptance ProposalAcceptance?
  events    ProposalEvent[]

  @@index([clientId, status])
  @@index([projectId])
  @@index([ownerId])
  @@index([validUntil])
  @@index([selectedOptionId])
}

model ProposalRevision {
  id           String    @id @default(cuid())
  proposalId   String
  authorId     String
  revision     Int
  title        String
  introduction String?
  terms        String?
  investment   Decimal?  @db.Decimal(12, 2)
  taxIncluded  Boolean   @default(false)
  sharedAt     DateTime?
  lockedAt     DateTime?
  replacedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  proposal  Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  author    AdminUser          @relation("RevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  sections  ProposalSection[]
  options   ProposalOption[]
  lineItems ProposalLineItem[]
  invites   ProposalInvite[]
  comments  ProposalComment[]
  decisions ProposalDecision[]
  acceptances ProposalAcceptance[]
  events    ProposalEvent[]

  @@unique([proposalId, revision])
  @@index([proposalId, sharedAt])
}

model ProposalSection {
  id         String              @id @default(cuid())
  revisionId String
  type       ProposalSectionType @default(CUSTOM)
  position   Int
  title      String
  content    String?
  metadata   Json?
  isIncluded Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  revision ProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, position])
  @@index([revisionId, type])
}

model ProposalOption {
  id          String   @id @default(cuid())
  revisionId  String
  code        String
  position    Int
  title       String
  description String?
  investment  Decimal? @db.Decimal(12, 2)
  taxIncluded Boolean  @default(false)
  recommended Boolean  @default(false)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  revision            ProposalRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  lineItems           ProposalLineItem[]
  selectedByProposals Proposal[]           @relation("ProposalSelectedOption")
  acceptances         ProposalAcceptance[]

  @@unique([revisionId, code])
  @@unique([revisionId, position])
}

model ProposalLineItem {
  id               String               @id @default(cuid())
  revisionId       String
  optionId         String?
  code             String
  description      String
  quantity         Decimal              @default(1) @db.Decimal(12, 3)
  unitPrice        Decimal              @db.Decimal(12, 2)
  discount         Decimal              @default(0) @db.Decimal(12, 2)
  taxRate          Decimal              @default(0) @db.Decimal(6, 4)
  type             ProposalLineItemType @default(ONE_TIME)
  position         Int
  visibleForClient Boolean              @default(true)
  internalCost     Decimal?             @db.Decimal(12, 2)
  markupPercent    Decimal?             @db.Decimal(6, 2)
  internalNotes    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  revision ProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  option   ProposalOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([revisionId, position])
  @@index([revisionId, optionId])
}

model ProposalInvite {
  id             String               @id @default(cuid())
  proposalId     String
  revisionId     String
  createdById    String
  tokenHash      String               @unique
  codeHash       String
  recipientEmail String?
  status         ProposalInviteStatus @default(ACTIVE)
  expiresAt      DateTime
  revokedAt      DateTime?
  firstViewedAt  DateTime?
  lastViewedAt   DateTime?
  viewCount      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  proposal  Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revision  ProposalRevision   @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  createdBy AdminUser          @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments  ProposalComment[]
  decisions ProposalDecision[]
  attempts  ProposalInviteAttempt[]
  acceptances ProposalAcceptance[]

  @@index([proposalId, status])
  @@index([revisionId])
  @@index([expiresAt])
}

model ProposalInviteAttempt {
  id        String   @id @default(cuid())
  inviteId  String
  createdAt DateTime @default(now())

  invite ProposalInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([inviteId, createdAt])
}

model ProposalComment {
  id            String   @id @default(cuid())
  proposalId    String
  revisionId    String
  inviteId      String?
  adminAuthorId String?
  authorName    String
  authorEmail   String?
  content       String
  isInternal    Boolean  @default(false)
  createdAt     DateTime @default(now())

  proposal    Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revision    ProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  invite      ProposalInvite?  @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  adminAuthor AdminUser?       @relation("AdminCommentAuthor", fields: [adminAuthorId], references: [id], onDelete: SetNull)

  @@index([proposalId, createdAt])
  @@index([revisionId, createdAt])
}

model ProposalDecision {
  id              String               @id @default(cuid())
  proposalId      String
  revisionId      String
  inviteId        String?
  type            ProposalDecisionType
  actorName       String
  actorEmail      String?
  note            String?
  acceptedTermsAt DateTime?
  createdAt       DateTime             @default(now())

  proposal Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revision ProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  invite   ProposalInvite?  @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@index([proposalId, createdAt])
  @@index([revisionId, createdAt])
}

model ProposalAcceptance {
  id                 String                     @id @default(cuid())
  proposalId         String                     @unique
  revisionId         String
  optionId           String?
  inviteId           String
  name               String
  email              String
  role               String
  company            String?
  ip                 String?
  userAgent          String?
  currency           String                     @db.VarChar(3)
  subtotal           Decimal                    @db.Decimal(12, 2)
  tax                Decimal                    @db.Decimal(12, 2)
  total              Decimal                    @db.Decimal(12, 2)
  terms              String?
  snapshot           Json
  contentHash        String
  verificationMethod ProposalVerificationMethod
  createdAt          DateTime                   @default(now())

  proposal Proposal         @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  revision ProposalRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  option   ProposalOption?  @relation(fields: [optionId], references: [id], onDelete: Restrict)
  invite   ProposalInvite   @relation(fields: [inviteId], references: [id], onDelete: Restrict)

  @@index([revisionId])
  @@index([inviteId])
  @@index([contentHash])
}

model ProposalEvent {
  id           String            @id @default(cuid())
  proposalId   String
  revisionId   String?
  adminActorId String?
  type         ProposalEventType
  metadata     Json?
  createdAt    DateTime          @default(now())

  proposal   Proposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  revision   ProposalRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  adminActor AdminUser?        @relation("EventAdminActor", fields: [adminActorId], references: [id], onDelete: SetNull)

  @@index([proposalId, createdAt])
  @@index([revisionId, createdAt])
}
