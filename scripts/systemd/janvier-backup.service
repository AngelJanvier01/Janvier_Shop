[Unit]
Description=JANVIER encrypted production backup to Git
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/janvier-backup.env
ExecStart=/bin/bash ${JANVIER_PROJECT_ROOT}/scripts/unix/production-backup-to-git.sh
NoNewPrivileges=true
