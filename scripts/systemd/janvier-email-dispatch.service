[Unit]
Description=JANVIER delivery of queued email notifications
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
User=janvier
Group=janvier
SupplementaryGroups=docker
WorkingDirectory=/opt/janvier-shop
EnvironmentFile=/opt/janvier-shop/.env.production
RuntimeDirectory=janvier-notifications
UMask=0077
ExecStart=/usr/bin/flock -n /run/janvier-notifications/email-dispatch.lock /usr/bin/docker compose --env-file /opt/janvier-shop/.env.production -f /opt/janvier-shop/compose.production.yaml run --rm --no-deps migrate npm run notifications:dispatch
TimeoutStartSec=55s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
