# Install as /etc/janvier-backup.env with mode 600. Do not commit real values.
JANVIER_PROJECT_ROOT=/srv/janvier/Janvier_Shop
BACKUP_GIT_REMOTE=git@github.com:AngelJanvier01/Janvier_Shop_Backups.git
BACKUP_GIT_BRANCH=main
BACKUP_AGE_RECIPIENT=age1replace_with_your_public_recipient
GIT_SSH_COMMAND="ssh -i /etc/janvier-backup/id_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
BACKUP_GIT_AUTHOR_NAME=JANVIER Backup
BACKUP_GIT_AUTHOR_EMAIL=backup@janvier.local
